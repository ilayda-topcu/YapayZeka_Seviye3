# ==========================================
# AgroPlus Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı '.env' olarak kopyalayıp kendi değerlerinizi girin.
# ==========================================

# Veritabanı Yapılandırması (MariaDB)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=agroplus
MARIADB_USER=agroplus
MARIADB_PASSWORD=your_mariadb_password_here
MARIADB_ROOT_PASSWORD=your_mariadb_root_password_here

# Sunucu & İstemci Bağlantı Ayarları
PORT=3001
VITE_API_BASE=http://localhost:3001/api

# Yapay Zeka Asistanı API Anahtarı
GEMINI_API_KEY=your_gemini_api_key_here
